%%meta name: Ticket Hooks
%%meta kind: workflow
%%workflow TicketHooks entity: Ticket kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: stampReference]
    C --> D[Process Ticket]
    D --> E[afterCreate: notifyCustomer]
    E --> F[afterUpdate: logStatusChange]
    F --> G[Response]

    %%hook beforeCreate stampReference on Ticket
    %%hook afterCreate notifyCustomer on Ticket
    %%hook afterUpdate logStatusChange on Ticket

%% ---- When each status was reached: stamped by the application ----
%% A record moves by an action button, along an edge its state diagram draws,
%% and the application writes the <state>_at time when it does.
%%field Ticket.in_progress_at help: When this ticket moved to in progress. Stamped by the application when the move is made; nobody types it.
%%field Ticket.closed_at help: When this ticket moved to closed. Stamped by the application when the move is made; nobody types it.
%%field Ticket.resolved_at help: When this ticket moved to resolved. Stamped by the application when the move is made; nobody types it.
%%section entity: Ticket; name: Progress; help: When this ticket reached each status, stamped by the application as the record moves; the status itself is shown in the header.; rows: in_progress_at, closed_at | resolved_at
